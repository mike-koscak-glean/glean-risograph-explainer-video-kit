# `npm run env:setup` copies this to .env automatically. Never commit .env.
ELEVENLABS_API_KEY=
# Pick one after `npm run voices`.
ELEVEN_VOICE_ID=
# Reference videos used ElevenLabs v3. Change if unavailable for your account.
ELEVEN_MODEL=eleven_v3
# Optional voice tuning.
ELEVEN_STABILITY=0.5
ELEVEN_STYLE=0.15
ELEVEN_SPEED=1.0
# Post-generation tempo; 1.075 is 7.5% faster without changing pitch.
VO_TEMPO=1.075
