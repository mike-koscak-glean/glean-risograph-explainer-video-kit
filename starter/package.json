{
  "name": "risograph-editorial-explainer-video-starter",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5198",
    "build": "tsc --noEmit && vite build",
    "env:setup": "node tools/setup-env.mjs",
    "env:check": "node tools/setup-env.mjs --check",
    "review:storyboard": "node tools/storyboard-gallery.ts",
    "review:script": "node tools/script-review.ts",
    "review:serve": "vite out --host 127.0.0.1 --port 5199",
    "voices": "node tools/voices.ts",
    "vo": "node tools/vo.ts",
    "vo:scratch": "node tools/vo-scratch.ts",
    "sfx": "node tools/sound.ts sfx",
    "music": "node tools/sound.ts music",
    "schedule": "node tools/render.ts --schedule",
    "render:draft": "node tools/render.ts --draft",
    "render": "node tools/render.ts",
    "render:4k": "node tools/render.ts --scale 2",
    "mix": "node tools/mix.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
